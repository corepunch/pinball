<!-- Every part on the table, as shapes and the modifiers nested in them. Nothing is a model file.
     Round parts are built to unit radius and elongated ones to unit half length along x; the game
     scales them. Z is up. Art/SCENES.md describes each element. -->
<kit>
 <prefab id="bolt">
  <lathe role="accent" segments="20" sharp="70" points="{radius},{z} {radius},{z+radius*.2} {radius*.84},{z+radius*.36} {radius*.62},{z+radius*.36}"/>
  <lathe role="metal" segments="16" sharp="80" points="{radius*.64},{z+radius*.28} {radius*.58},{z+radius*.56} {radius*.34},{z+radius*.84} .0001,{z+radius*.94}"/>
 </prefab>

 <!-- A mushroom: flared foot, black waist, and a wide cap overhanging them with a raised hub round the jewel. -->
 <prefab id="bumper-base">
  <lathe role="accent" segments="56" sharp="50" points=".88,0 .88,.06 .8,.11"/>
  <lathe role="black_rubber" segments="40" sharp="80" points=".8,.1 .56,.18 .4,.27 .3,.42 .28,.62 .34,.8 .5,.92"/>
 </prefab>
 <prefab id="bumper-cap">
  <lathe role="cap_art" segments="64" sharp="80" planar="1.92" points=".92,1.13 .72,1.16 .5,1.19"/>
  <lathe role="accent" segments="64" sharp="50" points=".46,.95 .94,.98 1,1.02 1,1.1 .95,1.15 .9,1.15"/>
  <lathe role="accent" segments="48" sharp="50" points=".56,1.17 .54,1.25 .48,1.3 .38,1.3 .34,1.26 .34,1.2"/>
  <lathe role="jewel" segments="36" sharp="80" planar=".69" points=".345,1.21 .335,1.28 .27,1.35 .15,1.4 .001,1.42"/>
 </prefab>

 <!-- A flipper, from a tapered bar: rubber edge, gold line, painted top. The table sets its proportions. -->
 <prefab id="flipper">
  <let name="H" value=".253"/>
  <capsule base="{base}" tip="{tip}" role="black_rubber" z=".03"><extrude amount="{H-.03-.012}"/><bevel amount=".02"/></capsule>
  <capsule base="{base*.84}" tip="{tip*.84}" role="accent" z="{H-.02}"><extrude amount=".012"/></capsule>
  <capsule base="{base*.76}" tip="{tip*.76}" role="flipper_art" z="{H-.006}" uv="0 .78 1 .95"><extrude amount=".008"/><bevel amount=".004"/></capsule>
  <lathe role="accent" segments="28" sharp="70" points="{base*.95},0 {base*.95},{H+.02} {base*.82},{H+.045} {base*.55},{H+.05}"/>
  <lathe role="metal" segments="20" sharp="80" points="{base*.58},{H+.04} {base*.46},{H+.08} {base*.22},{H+.1} .001,{H+.105}"/>
  <polygon role="sling_lens" z="{H+.006}" points=".38,0 .22,-.05 .22,.05"/>
  <polyline role="accent" sharp="70" points=".22,.05,{H+.003} .22,-.05,{H+.003} .38,0,{H+.003}"><sweep closed="true" section="-.006,0 -.006,.007 .006,.007 .006,0"/></polyline>
  <use prefab="bolt" radius="{tip*.42}" z="{H-.01}" at="1,0"/>
 </prefab>

 <!-- A slingshot from the table's outline: coloured base and top, cream band, inset cream line, a screw in each corner. -->
 <prefab id="slingshot">
  <let name="BAND" value=".03"/>
  <let name="LIP" value=".037"/>
  <polygon points="{outline}" role="{lens}" sharp="50"><fillet radius=".014"/><sweep section="0,0 0,.006 .0015,.0085"/></polygon>
  <polygon points="{outline}" role="enamel" sharp="50"><inset amount=".002"/><fillet radius=".012"/><sweep section="0,.007 0,{BAND}"/></polygon>
  <polygon points="{outline}" role="{lens}" sharp="50"><fillet radius=".014"/><sweep section=".002,{BAND} 0,{BAND+.002} 0,{LIP-.0025} .0025,{LIP}"/></polygon>
  <polygon points="{outline}" role="{lens}" z="{LIP}"><inset amount=".0025"/><fillet radius=".0115"/></polygon>
  <polygon points="{outline}" role="enamel" sharp="80"><inset amount=".0065"/><fillet radius=".0075"/><sweep section="0,{LIP+.0002} .0042,{LIP+.0002}"/></polygon>
  <each-corner points="{outline}" inset=".0175">
   <lathe role="metal" segments="14" sharp="70" points=".0058,{LIP} .0058,{LIP+.0012} .0042,{LIP+.0026} .001,{LIP+.0032}"/>
  </each-corner>
 </prefab>

 <!-- A low raised piece with a trim, such as the floor sloping to the drain beneath the flippers. -->
 <!-- The second level: a raised block with a rounded outline. The art shows on its top. -->
 <prefab id="deck">
  <polygon points="{outline}" role="cabinet_shell" sharp="50"><fillet radius=".02"/><sweep section="0,0 0,{height}"/></polygon>
  <polygon points="{outline}" role="cabinet_shell" z="{height}"><fillet radius=".02"/></polygon>
  <polygon points="{outline}" role="accent" sharp="80"><fillet radius=".02"/><sweep section="-.0042,{height-.006} -.0042,{height+.002} -.0014,{height+.0036} .0014,{height+.0036} .0042,{height+.002} .0042,{height-.006}"/></polygon>
 </prefab>

 <!-- A tall toy to give the board some height. It has no ball surface. Built to unit radius. -->
 <prefab id="beacon">
  <lathe role="accent" segments="40" sharp="50" points="1,0 1,.3 .82,.42 .62,.48"/>
  <lathe role="enamel" segments="40" sharp="50" points=".62,.46 .5,1.5 .42,3 .4,3.5"/>
  <lathe role="accent" segments="40" sharp="50" points=".62,3.3 .62,3.55 .42,3.65"/>
  <lathe role="jewel" segments="32" sharp="80" planar="1.6" points=".46,3.6 .46,4.3 .34,4.7 .001,4.9"/>
 </prefab>

 <prefab id="slide">
  <polygon points="{outline}" role="cabinet_shell" z="{height}"/>
  <polygon points="{outline}" role="cabinet_shell" sharp="80"><sweep section="-.0042,0 -.0042,{height-.002} -.0022,{height} .0022,{height} .0042,{height-.002} .0042,0"/></polygon>
 </prefab>

 <!-- The captive ball's low pod, with a recessed tray. -->
 <prefab id="docking-pod">
  <polygon points="{tray}" role="dark" z=".001"/>
  <polygon points="{outline}" role="dark" z=".02"/>
  <polygon points="{outline}" role="accent" sharp="65"><sweep section="-.0042,0 -.0042,.016 0,.023 .0042,.016 .0042,0"/></polygon>
 </prefab>

 <!-- Raised housing around painted art. -->
 <prefab id="housing">
  <polygon points="{outline}" role="block_art" z="{height}"/>
  <polygon points="{outline}" role="accent" sharp="80"><sweep section="-.0042,0 -.0042,{height+.002} -.0014,{height+.0036} .0014,{height+.0036} .0042,{height+.002} .0042,0"/></polygon>
 </prefab>

 <!-- Round lamp insert: a broad chamfered bezel and a clear lens over the painted insert. -->
 <prefab id="insert-bezel">
  <lathe role="dark" segments="40" points="1.1,-.025 1.1,.015 1.07,.04"/>
  <lathe role="accent" segments="48" sharp="50" points="1.095,.015 1.095,.07 1.055,.14 .94,.17 .86,.125 .84,.08 .84,.025"/>
  <lathe role="lens" segments="32" sharp="80" points=".84,.055 .77,.1 .6,.145 .32,.17 .001,.18"/>
 </prefab>

 <!-- Arrow lamp insert: apex on +x, narrowed so it has a direction. -->
 <prefab id="insert-arrow">
  <arrowhead role="accent" sharp="40"><sweep section="-.065,0 -.065,.1 .065,.1 .065,0"/></arrowhead>
  <arrowhead role="lens" sharp="80" scale=".93"><dome centre="origin" rings="1,.05 .6667,.2" apex=".26"/></arrowhead>
 </prefab>

 <prefab id="post">
  <lathe role="accent" segments="20" sharp="60" points="1,0 1,.55 .86,.75 .62,.8"/>
  <lathe role="metal" segments="16" sharp="80" points=".66,.74 .58,.98 .34,1.14 .001,1.2"/>
 </prefab>

 <!-- A drop target: unit length, scaled by its edge, art on top. -->
 <prefab id="target">
  <rect size="1.06 .3808" role="accent"><extrude amount="1"/><bevel amount=".03"/></rect>
  <rect size="1 .34" role="target_art" z="1.002"/>
 </prefab>

 <!-- A stand-up target: a domed lens in a broad gold ring. -->
 <!-- A round target: lying flat like the lamps, a low bezel round a shallow lens. -->
 <prefab id="spot-target">
  <lathe role="accent" segments="32" sharp="50" points="1,0 1,.2 .94,.27 .84,.26"/>
  <lathe role="target_lens" segments="32" sharp="80" planar="2" points=".85,.22 .6,.28 .3,.31 .001,.32"/>
 </prefab>

 <!-- A rollover switch: a wheel standing in a dark slot in a flat frame, half sunk, for the ball to roll over. -->
 <prefab id="rollover-plate">
  <let name="L" value="1"/>
  <let name="W" value=".46"/>
  <rounded-rect size="{2*W} {2*L}" radius="{W*.42}" role="plate_frame" z="{L*.02}"/>
  <rounded-rect size="{1.2*W} {1.68*L}" radius="{W*.3}" role="dark" z="{L*.03}"/>
  <wheel radius="{L*.74}" width="{W*.8}" z="{-L*.3}" role="metal"/>
 </prefab>

 <prefab id="flasher-cage">
  <lathe role="accent" segments="32" points="1.05,0 1.05,.1 .92,.22"/>
  <torus role="metal" major=".86" minor=".07" z=".24" segments="32"/>
 </prefab>

 <prefab id="bullet-lamp">
  <lathe role="accent" segments="28" points="1,0 1,.1 .92,.18 .8,.2"/>
  <torus role="metal" major=".78" minor=".07" z=".24" segments="28"/>
  <lathe role="{glow}" segments="24" sharp="80" points=".7,.2 .68,.42 .52,.62 .28,.76 .001,.8"/>
  <lathe role="lens" segments="24" sharp="80" points=".72,.24 .69,.44 .53,.64 .29,.78 .001,.82"/>
 </prefab>
 <prefab id="bullet-cyan"><use prefab="bullet-lamp" glow="glow"/></prefab>
 <prefab id="bullet-amber"><use prefab="bullet-lamp" glow="glow_amber"/></prefab>

 <prefab id="stud">
  <lathe role="accent" segments="24" points="1,0 1,.12 .86,.22 .72,.24"/>
  <lathe role="metal" segments="20" sharp="80" points=".74,.2 .7,.5 .5,.8 .26,.96 .001,1"/>
 </prefab>

 <prefab id="arrow-lens">
  <arrowhead role="accent"><sweep section="-.045,-.02 -.045,.08 -.0135,.13 .0135,.13 .045,.08 .045,-.02"/></arrowhead>
  <arrowhead role="sling_lens" sharp="80" scale=".9"><dome centre="origin" rings="1,.05 .6667,.16" apex=".22"/></arrowhead>
 </prefab>

 <prefab id="lit-arrow">
  <arrowhead role="{lens}" scale=".52" at="{x},0" mirror="{way}"><dome rings="1,.05 .8,.125 .48,.15" apex=".162"/></arrowhead>
  <arrowhead role="accent" sharp="70" scale=".52" at="{x},0" mirror="{way}"><sweep section="-.035,0 -.035,.08 0,.11 .035,.08 .035,0"/></arrowhead>
 </prefab>
 <prefab id="arrow-stack">
  <use prefab="lit-arrow" lens="sling_lens" x=".44" way="1"/>
  <use prefab="lit-arrow" lens="amber_lens" x="-.44" way="-1"/>
 </prefab>

 <prefab id="mech-bracket">
  <polygon role="metal" points="-0.846,-0.3396 -0.054,-0.4404 0.226,-0.4236 0.874,-0.2364 1,-0.144 1,0.144 0.888,0.2364 0.312,0.4236 0.032,0.4404 -0.832,0.3396 -1,0.2304 -1,-0.2304"><dome rings="1,.05 .8,.1175 .48,.14" apex=".1508"/></polygon>
  <polygon role="accent" sharp="70" points="-0.846,-0.3396 -0.054,-0.4404 0.226,-0.4236 0.874,-0.2364 1,-0.144 1,0.144 0.888,0.2364 0.312,0.4236 0.032,0.4404 -0.832,0.3396 -1,0.2304 -1,-0.2304"><sweep section="-.03,0 -.03,.06 0,.09 .03,.06 .03,0"/></polygon>
  <lathe role="accent" segments="24" sharp="70" at=".1,0" points=".3,.1 .3,.16 .25,.2"/>
  <lathe role="glow" segments="20" sharp="80" at=".1,0" points=".25,.17 .21,.27 .11,.34 .001,.36"/>
  <use prefab="bolt" radius=".13" z=".12" at="-.72,0"/>
  <use prefab="bolt" radius=".1" z=".12" at=".76,0"/>
 </prefab>

 <prefab id="mech-piston">
  <polyline role="accent" sharp="80" points="-.95,0,0 -.1,0,0"><sweep section="-0.3,0.02 -0.27716,0.12332 -0.21213,0.21092 -0.11481,0.26945 0,0.29 0.11481,0.26945 0.21213,0.21092 0.27716,0.12332 0.3,0.02"/></polyline>
  <polyline role="metal" sharp="80" points="-.1,0,0 .82,0,0"><sweep section="-0.099,0.0572 -0.09146,0.0944 -0.07,0.12593 -0.03789,0.147 0,0.1544 0.03789,0.147 0.07,0.12593 0.09146,0.0944 0.099,0.0572"/></polyline>
  <polyline role="metal" sharp="80" points="-0.985,0,0 -0.915,0,0"><sweep section="-0.342,0.0228 -0.31597,0.14059 -0.24183,0.24045 -0.13088,0.30717 0,0.3306 0.13088,0.30717 0.24183,0.24045 0.31597,0.14059 0.342,0.0228"/></polyline>
  <polyline role="accent" sharp="80" points="-0.655,0,0 -0.585,0,0"><sweep section="-0.342,0.0228 -0.31597,0.14059 -0.24183,0.24045 -0.13088,0.30717 0,0.3306 0.13088,0.30717 0.24183,0.24045 0.31597,0.14059 0.342,0.0228"/></polyline>
  <polyline role="accent" sharp="80" points="-0.315,0,0 -0.245,0,0"><sweep section="-0.342,0.0228 -0.31597,0.14059 -0.24183,0.24045 -0.13088,0.30717 0,0.3306 0.13088,0.30717 0.24183,0.24045 0.31597,0.14059 0.342,0.0228"/></polyline>
  <polyline role="metal" sharp="80" points="-0.135,0,0 -0.065,0,0"><sweep section="-0.342,0.0228 -0.31597,0.14059 -0.24183,0.24045 -0.13088,0.30717 0,0.3306 0.13088,0.30717 0.24183,0.24045 0.31597,0.14059 0.342,0.0228"/></polyline>
  <lathe role="accent" segments="16" sharp="70" at=".84,0" points=".2,0 .2,.14 .15,.2 .07,.22"/>
  <use prefab="bolt" radius=".09" z=".19" at=".84,0"/>
 </prefab>

 <prefab id="mech-stud">
  <lathe role="accent" segments="18" sharp="70" points="1,0 1,.32 .8,.55 .62,.62"/>
  <lathe role="accent" segments="18" sharp="70" points=".62,.55 .62,2.2 .86,2.45 .86,2.8 .62,3.05"/>
  <lathe role="metal" segments="18" sharp="80" points=".62,3 .56,3.45 .32,3.82 .001,3.95"/>
 </prefab>
 <prefab id="mech-tower">
  <lathe role="cabinet_shell" segments="20" sharp="65" points="1,0 1,.45 .78,.75 .7,.85"/>
  <lathe role="glow" segments="20" sharp="80" points=".7,.78 .65,1 .44,1.16 .001,1.2"/>
 </prefab>
</kit>
