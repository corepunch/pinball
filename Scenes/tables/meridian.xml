<!-- Crosswind: open right bank, left pops, a low spinner and a pause/return scoop. -->
<table id="meridian" name="MERIDIAN" defaultSkin="orbital" base="base">
 <walls>
  <wall id="laneGuideB" style="wall" height="0.018" radius="0.007" points="0.269625,1.44 0.269625,1.53" />
  <wall id="laneGuideC" style="wall" height="0.018" radius="0.007" points="0.364875,1.44 0.364875,1.53" />
 </walls>
 <bumpers>
  <bumper id="bumperA" x="0.22" y="1.20" r="0.068" />
  <bumper id="bumperB" x="0.43" y="1.20" r="0.068" />
 </bumpers>
 <dropTargets>
  <dropTarget id="dropA" a="0.66 1.30" rotation="guide" length="0.085" arrow="green" />
  <dropTarget id="dropB" a="0.60 1.14" rotation="guide" length="0.085" arrow="green" />
  <dropTarget id="dropC" a="0.54 0.98" rotation="guide" length="0.085" arrow="green" />
 </dropTargets>
 <saucers>
  <saucer id="scoopL" x="0.27" y="0.88" r="0.039" captureSpeed="5.5" ejectDirection="0.65 -1" ejectSpeed="1.25" arrow="cyan" />
 </saucers>
 <standups>
  <standup id="standA" a="0.48 0.74" b="0.56 0.76" arrow="amber" />
  <standup id="standB" a="0.70 0.84" b="0.78 0.82" arrow="amber" />
 </standups>
 <spinners>
  <spinner id="spinnerL" a="0.25 0.65" b="0.33 0.65" arrow="cyan" />
 </spinners>
 <rollovers>
  <rollover id="laneA" r="0.025" />
  <rollover id="laneB" r="0.025" />
  <rollover id="laneC" r="0.025" />
 </rollovers>
 <lamps>
  <lamp id="lampLaneA" x="0.222" y="1.56" size="0.02" color="amber" icon="0" bar="laneA" />
  <lamp id="lampLaneB" x="0.31725" y="1.56" size="0.02" color="amber" icon="0" bar="laneB" />
  <lamp id="lampLaneC" x="0.4125" y="1.56" size="0.02" color="amber" icon="0" bar="laneC" />
  <lamp id="lampShootAgain" x="0.457" y="0.31" size="0.026" color="white" icon="1" bind="shootAgain" />
 </lamps>
 <rules skillShotTarget="laneB" locksForMultiball="0">
  <groups>
   <group id="lanes" members="laneA laneB laneC" lamps="lampLaneA lampLaneB lampLaneC" rotateWithFlippers="true" completeScore="10000" actions="bonusX resetGroup" message="BONUS UP" />
   <group id="targets" members="standA standB" lamps="lampStandA lampStandB" completeScore="5000" actions="addBonus resetGroup" message="BONUS +" />
   <group id="drops" members="dropA dropB dropC" lamps="lampDropA lampDropB lampDropC" completeScore="7500" actions="addBonus resetDrops" message="TARGETS CLEAR" />
  </groups>
 </rules>
</table>
