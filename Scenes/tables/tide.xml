 <standups>
  <standup id="standA" a="0.37 0.73" b="0.45 0.75" arrow="amber" />
  <standup id="standB" a="0.75 1.36" b="0.83 1.34" arrow="amber" />
 </standups>
 <spinners>
  <spinner id="spinnerL" a="0.08 0.82" b="0.16 0.82" arrow="cyan" />
  <spinner id="spinnerR" a="0.75 0.68" b="0.83 0.68" arrow="cyan" />
 </spinners>
 <rollovers>
  <rollover id="laneA" r="0.025" />
  <rollover id="laneB" r="0.025" />
  <rollover id="laneC" r="0.025" />
 </rollovers>
 <lamps>
  <lamp id="lampLaneA" x="0.382" y="1.56" size="0.02" color="amber" icon="0" bar="laneA" />
  <lamp id="lampLaneB" x="0.47725" y="1.56" size="0.02" color="amber" icon="0" bar="laneB" />
