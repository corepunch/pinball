 <bumpers>
  <bumper id="bumperA" x="0.38" y="1.25" r="0.068" />
  <bumper id="bumperB" x="0.60" y="1.22" r="0.068" />
  <bumper id="bumperC" x="0.48" y="1.03" r="0.068" />
 </bumpers>
 <dropTargets>
  <dropTarget id="dropA" a="0.15 1.28" rotation="-guide" length="0.085" arrow="green" />
  <dropTarget id="dropB" a="0.19 1.09" rotation="-guide" length="0.085" arrow="green" />
  <dropTarget id="dropC" a="0.23 0.90" rotation="-guide" length="0.085" arrow="green" />
 </dropTargets>
